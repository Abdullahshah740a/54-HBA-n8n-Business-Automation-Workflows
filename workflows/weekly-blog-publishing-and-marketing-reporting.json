      "id": "EXAMPLE_UUID_6470DC6B85",
      "name": "WordPress: Get Posts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1264,
        640
      ]
    },
    {
      "parameters": {
        "jsCode": "// Count WordPress published posts per ISO week (Monday-dated), to fill\n// Marketing Engine -> \"Blogs Published\". The WP HTTP node returns one item per post.\nconst items = $input.all();\nconst byWeek = {};\nfor (const it of items){\n  const p = it.json;\n  const raw = (p.date || p.date_gmt || '').slice(0,10);\n  if (!raw) continue;\n  const d = new Date(raw + 'T00:00:00');\n  const dow = d.getDay();                 // 0=Sun .. 6=Sat\n  const monday = new Date(d);\n  monday.setDate(d.getDate() + (dow === 0 ? -6 : 1 - dow));\n  const wk = monday.toISOString().slice(0,10);\n  byWeek[wk] = (byWeek[wk] || 0) + 1;\n}\nreturn Object.keys(byWeek).sort().map(w => ({ json: {\n  'Week': w,\n  'Week Key': w,\n  'Blogs Published': byWeek[w]\n}}));"
      },
      "id": "EXAMPLE_UUID_417C610271",
